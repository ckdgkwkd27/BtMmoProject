# Local IDE settings and Python caches
.vs/
.idea/
*.DotSettings.user
*.vcxproj.user
__pycache__/

# Markdown documents and local formatting configuration
*.md
.clang-format

# Server build outputs, dependencies and local settings
/BtMmoProject/**/bin/
/BtMmoProject/**/obj/
/BtMmoProject/packages/
/BtMmoProject/**/riderModule.iml
/BtMmoProject/_ReSharper.Caches/
/BtMmoProject/**/.deps/
/BtMmoProject/**/cmake-build-*/
/BtMmoProject/**/out/
/BtMmoProject/**/x64/
/BtMmoProject/**/Win32/

# Server directories excluded from version control
/BtMmoProject/Build/
/BtMmoProject/scripts/
/BtMmoProject/tests/

# Client: keep project metadata and authored C++ sources only
/BtMmoClient/*
!/BtMmoClient/BtMmoClient.uproject
!/BtMmoClient/Source/
!/BtMmoClient/Plugins/

# Client runtime sources and Unreal build definitions
/BtMmoClient/Source/**
!/BtMmoClient/Source/**/
!/BtMmoClient/Source/**/*.h
!/BtMmoClient/Source/**/*.cpp
!/BtMmoClient/Source/**/*.Build.cs
!/BtMmoClient/Source/**/*.Target.cs

# Unmodified Unreal template examples and automation tests
/BtMmoClient/Source/BtMmoClient/Variant_Combat/
/BtMmoClient/Source/BtMmoClient/Variant_Platforming/
/BtMmoClient/Source/BtMmoClient/Variant_SideScrolling/
/BtMmoClient/Source/BtMmoClient/Tests/

# Authored navigation export plugin; exclude its generated outputs
/BtMmoClient/Plugins/*
!/BtMmoClient/Plugins/BtNavMeshExport/
/BtMmoClient/Plugins/BtNavMeshExport/*
!/BtMmoClient/Plugins/BtNavMeshExport/BtNavMeshExport.uplugin
!/BtMmoClient/Plugins/BtNavMeshExport/Source/
/BtMmoClient/Plugins/BtNavMeshExport/Source/**
!/BtMmoClient/Plugins/BtNavMeshExport/Source/**/
!/BtMmoClient/Plugins/BtNavMeshExport/Source/**/*.h
!/BtMmoClient/Plugins/BtNavMeshExport/Source/**/*.cpp
!/BtMmoClient/Plugins/BtNavMeshExport/Source/**/*.Build.cs
