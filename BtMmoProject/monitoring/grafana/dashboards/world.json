{
  "uid": "btmmo-world",
  "title": "BtMmo 월드 서버",
  "tags": [
    "btmmo"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "접속 세션 수",
      "description": "현재 서버가 보유한 게임 TCP 세션 수입니다. 지표 수집용 HTTP 연결은 제외합니다.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "btmmo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "btmmo_connected_sessions{job=\"btmmo-world\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "title": "AI 틱 시간 p95",
      "description": "몬스터 행동 틱 실행 시간의 95번째 백분위 추정치입니다. 타이머와 작업 큐 대기 시간은 제외합니다.",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "btmmo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "1000 * histogram_quantile(0.95, sum by (instance, le) (rate(btmmo_ai_tick_duration_seconds_bucket{job=\"btmmo-world\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "title": "초당 송신 바이트",
      "description": "게임 소켓에서 IOCP 송신 완료가 확인된 바이트의 초당 전송률입니다.",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "btmmo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "rate(btmmo_sent_bytes_total{job=\"btmmo-world\"}[$__rate_interval])",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "wideLayout": true
      }
    }
  ]
}
